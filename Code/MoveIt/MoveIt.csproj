		</Reference>

		<!-- Keep: removing this causes CS0518 / missing predefined types in this project -->
		<Reference Include="mscorlib">
			<Private>False</Private>
			<HintPath>$(ManagedPath)\mscorlib.dll</HintPath>
		</Reference>
	</ItemGroup>

