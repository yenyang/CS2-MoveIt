* text=auto

# Visual Studio / C# (CRLF)
*.sln      text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.cs       text eol=crlf
*.ps1      text eol=crlf

# Publishing metadata edited/rewritten by MSBuild (CRLF avoids XmlPoke mixed-EOL)
*.xml      text eol=crlf
*.md       text eol=crlf

# Data files (LF is fine)
*.json     text eol=lf

# Shell scripts (LF)
*.sh       text eol=lf
*.bash     text eol=lf

# Binaries
*.png binary
*.jpg binary
*.svg binary
*.ico binary