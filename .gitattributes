* text=auto

# Windows-style line endings for VS project files and C#
*.sln      text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.cs       text eol=lf
# optional: LF renders nicer on GitHub
*.md       text eol=lf
*.json text eol=lf

# Scripts
*.sh       text eol=lf
*.bash     text eol=lf
*.ps1      text eol=lf

# Binaries
*.png binary
*.jpg binary
*.svg binary
*.ico binary